# このファイルを .streamlit/secrets.toml にコピーして値を設定してください。
# secrets.toml は .gitignore で Git 管理外になっています。

# 必須: Google AI Studio で発行した API キー（無料枠）
GEMINI_API_KEY = "your-api-key-here"

# 任意: モデル名を上書き（未設定なら config/settings.toml の値）
# GEMINI_MODEL = "gemini-3.5-flash-lite"

# 任意: 設定するとアプリ起動時にパスコード入力を求めます（無料枠の保護）
# APP_PASSCODE = "change-me"
